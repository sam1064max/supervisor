# ============================================================================
# Supervisor Agent - Environment Configuration Example
# Copy this file to .env and fill in real values for your environment.
# Never commit a populated .env. The .env file is gitignored.
# ============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
SUPERVISOR_ENV=development           # development | testing | production
SUPERVISOR_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR | CRITICAL
SUPERVISOR_LOG_FORMAT=json           # json | console

# ----------------------------------------------------------------------------
# LLM Provider
# ----------------------------------------------------------------------------
# Provider name. Built-in: "fake" (offline, deterministic, default for tests),
# "openai", "anthropic". The fake provider is recommended for development and
# CI. Production deployments should set a real provider with credentials.
SUPERVISOR_LLM_PROVIDER=fake
SUPERVISOR_LLM_MODEL=gpt-4o-mini

# Provider credentials. Only required for the matching provider. Never commit
# real secrets. Use your secret manager of choice in production.
SUPERVISOR_LLM_API_KEY=
SUPERVISOR_LLM_BASE_URL=
SUPERVISOR_LLM_TIMEOUT_S=30
SUPERVISOR_LLM_MAX_RETRIES=2

# ----------------------------------------------------------------------------
# Orchestration
# ----------------------------------------------------------------------------
# Maximum number of times the Reviewer can bounce work back to the Writer
# before the system accepts the draft as final.
SUPERVISOR_MAX_REVIEW_CYCLES=3

# Maximum number of retry attempts for any failing specialist agent.
SUPERVISOR_AGENT_MAX_RETRIES=2

# Human-in-the-loop checkpoint. When enabled, the graph interrupts before
# returning the final answer so an operator can approve / reject.
SUPERVISOR_HUMAN_REVIEW_ENABLED=false

# Parallel execution cap. Limits how many specialist agents may execute
# concurrently within a single supervisor pass.
SUPERVISOR_MAX_PARALLEL_AGENTS=4

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
# Toggle JSON tracing. The trace_id is propagated to every log record.
SUPERVISOR_TRACE_ENABLED=true
# Optional OTLP endpoint for distributed tracing (HTTP/protobuf).
SUPERVISOR_OTLP_ENDPOINT=
